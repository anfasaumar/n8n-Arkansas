        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Positive\",\n        \"Neutral\",\n        \"Negative\"\n      ],\n      \"description\": \"Sentimen feedback karyawan\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Salary\",\n        \"Facilities\",\n        \"Management\",\n        \"Workload\",\n        \"Training\",\n        \"Other\"\n      ],\n      \"description\": \"Kategori masalah/topik feedback\"\n    },\n    \"action_plan\": {\n      \"type\": \"string\",\n      \"description\": \"Satu kalimat rencana tindak lanjut dalam Bahasa Indonesia\"\n    }\n  },\n  \"required\": [\n    \"sentiment\",\n    \"category\",\n    \"action_plan\"\n  ],\n  \"additionalProperties\": false\n}"
