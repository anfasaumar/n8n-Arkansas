    {
      "parameters": {
        "jsCode": "const log = $('Cari Pengajuan').first().json;\nconst rows = $input.all().map(i => i.json);\nconst emailLog = String(log['Email'] || '').trim().toLowerCase();\nconst emp = rows.find(r => String(r['Email'] || '').trim().toLowerCase() === emailLog);\nif (!emp) throw new Error('Email karyawan tidak ditemukan di sheet Karyawan: ' + log['Email']);\n\nconst saldoLama = Number(emp['Saldo Cuti']);\nconst durasi = Number(log['Durasi']);\n\nreturn [{ json: { 'Email': emp['Email'], 'Saldo Cuti': saldoLama - durasi } }];"
      },
