        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Kamu content planner media sosial. Dari pesan pengguna (format: tanggal | tema), buat rencana konten satu hari penuh dalam Bahasa Indonesia, 5 slot waktu. Setiap slot berisi time_slot (contoh 08:00-09:00), title (judul ide konten, singkat dan visual), dan focus (tujuan/fokus konten). Balas hanya sesuai format JSON yang diminta."
            }
          ]
        }
      },
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        0,
        0
      ],
      "id": "85c838e3-3c15-4939-83df-46ce7a0498e8",
      "retryOnFail": true
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.8-flash",
        "options": {}
      },
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -48,
        208
      ],
      "id": "45583a2e-2ac6-4ac8-a3c3-01a8d1716c5a",
