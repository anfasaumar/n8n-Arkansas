        "jsCode": "// Biner foto Telegram -> Base64 (untuk upload KIE) -> kembali ke Buffer (validasi + biner baru)\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = buf.toString('base64');\nconst kembali = Buffer.from(b64, 'base64');\nconst binary = await this.helpers.prepareBinaryData(kembali, 'foto.jpg', 'image/jpeg');\nreturn [{\n  json: {\n    base64Data: `data:image/jpeg;base64,${b64}`,\n    fileName: `telegram_${Date.now()}.jpg`,\n    ukuranByte: kembali.length\n  },\n  binary: { data: binary }\n}];"
      },
