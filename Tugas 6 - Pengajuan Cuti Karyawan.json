    {
      "parameters": {
        "jsCode": "// Ambil data dari form dan hasil lookup karyawan\nconst form = $('Form Pengajuan Cuti').first().json;\nconst rows = $input.all().map(i => i.json);\nconst emailForm = String(form['Email'] || '').trim().toLowerCase();\nconst emp = rows.find(r => String(r['Email'] || '').trim().toLowerCase() === emailForm) || {};\nconst zone = 'Asia/Jakarta';\n\nconst mulai = DateTime.fromISO(String(form['Tanggal Mulai']), { zone });\nconst selesai = DateTime.fromISO(String(form['Tanggal Selesai']), { zone });\nconst hariIni = DateTime.now().setZone(zone).startOf('day');\n\nlet valid = true;\nlet alasanTolak = '';\nlet durasi = 0;\n\nconst saldo = Number(emp['Saldo Cuti']);\n\nif (!emp || !emp['Email']) {\n  valid = false;\n  alasanTolak = 'Email tidak terdaftar di database karyawan.';\n} else if (!mulai.isValid || !selesai.isValid) {\n  valid = false;\n  alasanTolak = 'Format tanggal tidak valid.';\n} else if (selesai < mulai) {\n  valid = false;\n  alasanTolak = 'Tanggal selesai lebih awal dari tanggal mulai.';\n} else if (mulai < hariIni) {\n  valid = false;\n  alasanTolak = 'Tanggal mulai cuti sudah terlewat.';\n} else {\n  // Hitung durasi dalam hari kerja (Senin-Jumat) secara inklusif\n  let cursor = mulai;\n  while (cursor <= selesai) {\n    if (cursor.weekday < 6) durasi++;\n    cursor = cursor.plus({ days: 1 });\n  }\n  if (durasi === 0) {\n    valid = false;\n    alasanTolak = 'Rentang tanggal yang dipilih hanya berisi akhir pekan.';\n  } else if (saldo < durasi) {\n    valid = false;\n    alasanTolak = `Saldo cuti tidak mencukupi (saldo ${saldo} hari, diajukan ${durasi} hari).`;\n  }\n}\n\nconst requestId = 'CUTI-' + DateTime.now().setZone(zone).toFormat('yyyyLLddHHmmss');\nconst BASE_URL = 'https://n8n-izdwrqgdb6yh.jkt6.sumopod.my.id/webhook/approval-cuti';\n\nreturn [{\n  json: {\n    valid,\n    alasanTolak,\n    requestId,\n    email: form['Email'],\n    nama: emp['Nama'] || '',\n    emailManajer: emp['Email Manajer'] || '',\n    tanggalMulai: mulai.isValid ? mulai.toFormat('yyyy-LL-dd') : '',\n    tanggalSelesai: selesai.isValid ? selesai.toFormat('yyyy-LL-dd') : '',\n    tanggalMulaiTampil: mulai.isValid ? mulai.setLocale('id').toFormat('dd LLLL yyyy') : '',\n    tanggalSelesaiTampil: selesai.isValid ? selesai.setLocale('id').toFormat('dd LLLL yyyy') : '',\n    durasi,\n    saldoSaatIni: saldo,\n    sisaSaldoJikaDisetujui: saldo - durasi,\n    alasan: form['Alasan'],\n    linkSetujui: `${BASE_URL}?id=${requestId}&status=approved`,\n    linkTolak: `${BASE_URL}?id=${requestId}&status=rejected`\n  }\n}];"
      },
