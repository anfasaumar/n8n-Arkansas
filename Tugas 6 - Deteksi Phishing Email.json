        "options": {
          "temperature": 0.1
        }
      },
      "id": "c1448ac5-494f-422f-9aae-25d1278b93e2",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        544,
        512
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "KpS0OsR984EL3Rr4",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Ekstrak skor risiko (1-10) dari respons teks AI\nconst aiText = $json.text || '';\nconst email = $('Gmail Trigger').item.json;\n\n// Prioritas 1: pola \"SKOR: 8\"; Prioritas 2: angka 1-10 pertama di teks\nlet match = aiText.match(/SKOR\\s*[:=]\\s*(10|[1-9])\\b/i) || aiText.match(/\\b(10|[1-9])\\b/);\n\nlet score;\nlet parsed = true;\nif (match) {\n  score = parseInt(match[1], 10);\n} else {\n  // Fail-safe: jika skor tidak terbaca, anggap berisiko agar ditinjau manusia\n  score = 7;\n  parsed = false;\n}\n\nconst reasonMatch = aiText.match(/ALASAN\\s*[:=]\\s*([\\s\\S]*)/i);\n\nreturn {\n  json: {\n    emailId: email.id,\n    from: email.from?.text || '',\n    subject: email.subject || '',\n    riskScore: score,\n    scoreParsed: parsed,\n    reason: reasonMatch ? reasonMatch[1].trim() : aiText.trim(),\n    aiRaw: aiText\n  }\n};"
      },
