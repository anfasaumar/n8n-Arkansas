    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Invoice {{ $json.nomor_invoice }}</title>\n<style>\nbody { font-family: Arial, sans-serif; color: #222; margin: 40px; }\nh1 { margin: 0; color: #1a56db; }\n.info { margin: 24px 0; }\ntable { width: 100%; border-collapse: collapse; }\nth, td { border: 1px solid #ccc; padding: 10px; text-align: left; }\nth { background: #1a56db; color: #fff; }\n.total { text-align: right; font-size: 18px; margin-top: 20px; }\n.footer { margin-top: 40px; font-size: 12px; color: #666; }\n</style>\n</head>\n<body>\n<h1>INVOICE</h1>\n<p>\n  No. Invoice: {{ $json.nomor_invoice }}<br>\n  Tanggal: {{ $json.tanggal_invoice }}\n</p>\n<div class=\"info\">\n  <strong>Ditagihkan kepada:</strong><br>\n  {{ $json.nama_klien }}<br>\n  {{ $json.email_klien }}\n</div>\n<h3>Detail Tagihan</h3>\n<table>\n  <tr>\n    <th>Deskripsi</th>\n    <th>Jam Kerja</th>\n    <th>Rate per Jam</th>\n    <th>Subtotal</th>\n  </tr>\n  <tr>\n    <td>Jasa profesional</td>\n    <td>{{ $json.jam_kerja }} jam</td>\n    <td>{{ $json.rate_idr }}</td>\n    <td>{{ $json.total_biaya_idr }}</td>\n  </tr>\n</table>\n<p class=\"total\"><strong>Total Biaya: {{ $json.total_biaya_idr }}</strong></p>\n<p class=\"footer\">\n  Terima kasih atas kepercayaan Anda. Dokumen ini dibuat otomatis oleh sistem.\n</p>\n</body>\n</html>"
      },
