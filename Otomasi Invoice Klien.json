    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst nomor = $('Edit Fields').first().json.nomor_invoice;\nitem.binary.data.fileName = nomor + '.pdf';\nitem.binary.data.mimeType = 'application/pdf';\nitem.binary.data.fileExtension = 'pdf';\nreturn item;"
      },
