    {
      "parameters": {
        "jsCode": "// Kunci zona waktu Jakarta (server n8n biasanya UTC)\nconst now = DateTime.now().setZone('Asia/Jakarta');\n\n// Urutan tanggal di kolom Scheduled Date jika formatnya dd/mm/yyyy atau mm/dd/yyyy.\n// 'DMY' = 11/02/2026 dibaca 11 Februari 2026. Ganti ke 'MDY' jika sheet kamu bermain format Amerika.\nconst DATE_ORDER = 'DMY';\n\nconst pad = (n) => String(n).padStart(2, '0');\nconst postsToSend = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const dateStr = String(row['Scheduled Date'] ?? '').trim();\n  const timeStr = String(row['Scheduled Time'] ?? '').trim();\n  const status = String(row['Status'] ?? '').trim();\n\n  // 1) Status harus Pending, 2) tanggal dan waktu tidak boleh kosong\n  if (status === 'Pending' && dateStr && timeStr) {\n    // Normalisasi tanggal ke yyyy-MM-dd\n    let isoDate = dateStr;\n    if (dateStr.includes('/')) {\n      const [a, b, y] = dateStr.split('/');\n      const day = DATE_ORDER === 'DMY' ? a : b;\n      const month = DATE_ORDER === 'DMY' ? b : a;\n      isoDate = `${y}-${pad(month)}-${pad(day)}`;\n    }\n\n    // Normalisasi waktu ke HH:mm:ss (jam 9:30:00 menjadi 09:30:00)\n    const [h, m = '0', s = '0'] = timeStr.split(':');\n    const isoTime = `${pad(h)}:${pad(m)}:${pad(s)}`;\n\n    // Gabungkan menjadi string ISO, lalu parse dengan Luxon\n    const dateTimeString = `${isoDate}T${isoTime}`;\n    const scheduledTime = DateTime.fromISO(dateTimeString, { zone: 'Asia/Jakarta' });\n\n    // 3) Waktu jadwal valid dan sudah lewat atau sama dengan sekarang\n    if (scheduledTime.isValid && scheduledTime <= now) {\n      postsToSend.push(item);\n    }\n  }\n}\n\nreturn postsToSend;\n"
      },
