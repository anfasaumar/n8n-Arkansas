      "parameters": {
        "jsCode": "// Langkah 5: format pesan Telegram (HTML: emoji + bold)\nconst data = $('Agregasi Top 5 Jam').all().map(i => i.json);\nconst medali = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣'];\nconst tanggal = $now.setZone('Asia/Jakarta').setLocale('id').toFormat('cccc, dd LLLL yyyy');\n\nlet pesan = '📊 <b>LAPORAN HARIAN: JAM TERBAIK POSTING</b> 📊\\n';\npesan += '🗓️ ' + tanggal + '\\n';\npesan += '━━━━━━━━━━━━━━━━━━\\n\\n';\npesan += '🚀 <b>Top 5 jam dengan engagement tertinggi:</b>\\n\\n';\n\ndata.forEach((d, i) => {\n  pesan += medali[i] + ' <b>Pukul ' + d['Jam'] + ' WIB</b>\\n';\n  pesan += '    🔥 Rata-rata skor: <b>' + d['Rata-rata Engagement'] + '</b>';\n  pesan += ' (' + d['Jumlah Postingan'] + ' postingan)\\n\\n';\n});\n\npesan += '━━━━━━━━━━━━━━━━━━\\n';\npesan += '💡 <i>Skor = Like x1 + Comment x2 + Share x3</i>\\n';\npesan += '✅ Jadwalkan konten pentingmu di jam-jam di atas!';\n\nreturn [{ json: { text: pesan } }];\n"
      },
