    {
      "parameters": {
        "jsCode": "// Langkah 2: fungsi menghitung Engagement Score tiap postingan\n// Bobot: Like x1, Comment x2, Share x3\nconst BOBOT = { likes: 1, comments: 2, shares: 3 };\n\nfunction hitungEngagement(likes, comments, shares) {\n  return (likes * BOBOT.likes) + (comments * BOBOT.comments) + (shares * BOBOT.shares);\n}\n\nconst hasil = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  // lewati baris kosong\n  if (row['Jam Posting'] === '' || row['Jam Posting'] === undefined) continue;\n\n  const likes = Number(row['Likes']) || 0;\n  const comments = Number(row['Comments']) || 0;\n  const shares = Number(row['Shares']) || 0;\n\n  hasil.push({\n    json: {\n      tanggal: row['Tanggal Posting'],\n      jam: Number(row['Jam Posting']),\n      platform: row['Platform'],\n      likes,\n      comments,\n      shares,\n      engagement_score: hitungEngagement(likes, comments, shares)\n    }\n  });\n}\nreturn hasil;\n"
      },
      "id": "3fa05eda-6ebd-4ac0-89b1-2495c08ed02f",
      "name": "Hitung Engagement Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Langkah 3: agregasi rata-rata engagement per jam, urutkan, ambil 5 terbaik\nconst grup = {};\nfor (const item of $input.all()) {\n  const { jam, engagement_score } = item.json;\n  if (!grup[jam]) grup[jam] = { total: 0, jumlah: 0 };\n  grup[jam].total += engagement_score;\n  grup[jam].jumlah += 1;\n}\n\nconst rataRata = Object.entries(grup).map(([jam, g]) => ({\n  jam: Number(jam),\n  rata_rata: Math.round((g.total / g.jumlah) * 100) / 100,\n  jumlah: g.jumlah\n}));\n\n// urutkan dari rata-rata tertinggi, ambil 5 teratas\nrataRata.sort((a, b) => b.rata_rata - a.rata_rata);\nconst top5 = rataRata.slice(0, 5);\n\nreturn top5.map((r, i) => ({\n  json: {\n    'Peringkat': i + 1,\n    'Jam': String(r.jam).padStart(2, '0') + ':00',\n    'Rata-rata Engagement': r.rata_rata,\n    'Jumlah Postingan': r.jumlah\n  }\n}));\n"
      },
      "id": "824a6a5f-1f88-4263-be5b-b2f330a3a72d",
